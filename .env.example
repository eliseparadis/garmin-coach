# Copy this file to .env and fill in your own values. Never commit .env.

GARMIN_USERNAME=you@example.com
GARMIN_PASSWORD=your-garmin-password
GARMIN_TOKENS_DIR=./.garmin_tokens
TRAINING_DB_PATH=../TrainingData/training.db

# Banister TRIMP coefficient pair used for the ACWR load proxy (see
# references/calculations.md). Must be "female" or "male" -- these are not
# interchangeable, pick the one that matches whoever's data this is.
TRIMP_SEX=female
